Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /OctoMap_Occupied_Cells1
        - /OctoMap_Point_Centers1
        - /AStar_3D_Path1
      Splitter Ratio: 0.5
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Cell Size: 1
      Color: 160; 160; 160
      Alpha: 0.5
      Line Style:
        Value: Lines
        Line Width: 0.03
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Marker Scale: 0.5
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Tree:
        {}
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: OctoMap_Occupied_Cells
      Namespaces:
        {}
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupied_cells_vis_array
      Value: true

    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: OctoMap_Point_Centers
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /octomap_point_cloud_centers
      Queue Size: 10
      Selectable: true
      Style: Points
      Size (Pixels): 3
      Size (m): 0.04
      Alpha: 0.8
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Position Transformer: XYZ
      Use Fixed Frame: true
      Value: true

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: AStar_3D_Path
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /astar_path
      Line Style: Lines
      Line Width: 0.08
      Color: 25; 255; 0
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
      Value: true

  Enabled: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Name: root

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point

  Transformation:
    Current:
      Class: rviz_default_plugins/TF

  Value: true

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.9
      Target Frame: <Fixed Frame>
      Yaw: 0.78
    Saved: ~

Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 40